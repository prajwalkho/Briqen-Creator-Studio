# GEMINI_API_KEY: Required for Gemini AI API calls (LLM, Image, Video, TTS, Lyria).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional API key for OpenAI LLM (gpt-4o-mini) and Image (dall-e-3) providers.
OPENAI_API_KEY=""
# Optional custom model overrides for OpenAI
OPENAI_LLM_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"
# Optional OpenAI video endpoint (if provisioned); otherwise VIDEO_PROVIDER=openai reports a clear capability error
OPENAI_VIDEO_ENDPOINT=""
OPENAI_VIDEO_MODEL="sora-2"

# Provider Selection: gemini | openai | mock
# Defaults to "gemini" when GEMINI_API_KEY is configured, otherwise "mock" for deterministic local runs.
LLM_PROVIDER="gemini"
IMAGE_PROVIDER="gemini"
VIDEO_PROVIDER="gemini"

# AI Worker Limits
AI_REQUEST_TIMEOUT="120"
AI_MAX_RETRIES="3"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://briqen-creator-studio.vercel.app"

# MEDIA_SIGNING_SECRET: Optional HMAC secret for signing media download URLs.
MEDIA_SIGNING_SECRET="a8f7d92ytc4e1b645f5a9d3e7c2b8f1a4lkd6e"

# OBJECT_STORAGE_DIR: Local object storage root path (default: ./storage/objects)
OBJECT_STORAGE_DIR="./storage/objects"

# DEFAULT_USER_CREDITS: Initial studio mock credits for newly registered creators
DEFAULT_USER_CREDITS="1000"

# Demo Accounts & Quick Login (development/staging only — must be false or unset in production)
ENABLE_DEMO_ACCOUNTS=true
ENABLE_DEMO_LOGIN=true
DEMO_ACCOUNT_PASSWORD=

