# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MEDIA_SIGNING_SECRET: Optional HMAC secret for signing media download URLs.
# If unset, the server generates an ephemeral in-memory secret at startup.
MEDIA_SIGNING_SECRET=""

# OBJECT_STORAGE_DIR: Local object storage root path (default: ./storage/objects)
OBJECT_STORAGE_DIR="./storage/objects"

# DEFAULT_USER_CREDITS: Initial studio mock credits for newly registered creators
DEFAULT_USER_CREDITS="1000"
